# Stripe — donations. Absent: donate page shows mail-a-check fallback.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend — newsletter and volunteer forms. Absent: forms become mailto links.
RESEND_API_KEY=
CONTACT_TO_EMAIL=mail@mapacnc.com

# Public site URL, used for Stripe redirect URLs, sitemap, robots and metadata.
# REQUIRED for production builds (`next build` fails without it). Set to https://mapacnc.com.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
